OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_UTILITY_MODEL=gpt-5.4-nano
# Пусто -> SQLite ./po_agent.db (локальный запуск). В docker-compose подставляется Postgres.
DATABASE_URL=
AUTH_COOKIE_DAYS=30
CONTEXT_MESSAGES_LIMIT=25
MAX_RESPONSE_TOKENS=600
PROPOSAL_EXPIRY_DAYS=5
STANDUP_COLLECTION_HOURS=4
PROACTIVE_ENABLED=true
PROACTIVE_MAX_PER_DAY=2
QUIET_HOURS_START=22
QUIET_HOURS_END=9
RISK_SCAN_CRON=0 6 * * *
DAILY_MESSAGE_LIMIT_PER_TEAM=200
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
BASE_URL=http://localhost:8000
SECRET_KEY=dev-secret-change-me
TZ=Europe/Moscow
